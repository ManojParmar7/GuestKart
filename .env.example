# Copy to apps/api/.env. Demo mode resets when the API restarts.
PORT=4100
WEB_ORIGIN=http://localhost:3000
DATABASE_MODE=memory
# Production requires DATABASE_MODE=mongo and a replica set (Atlas works).
MONGODB_URI=mongodb://localhost:27017/guestkart?replicaSet=rs0
# Replace with at least 32 random characters before deployment.
JWT_SECRET=replace-this-with-a-long-random-secret-before-production
ADMIN_EMAIL=admin@guestkart.local
ADMIN_PASSWORD=GuestKartDemo!2026
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NODE_ENV=development
